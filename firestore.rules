rules_version = '2';

// 모일까용 규칙
// - 프로젝트(projects)는 관리자만 만들고, 고치고(장소 후보), 지우고, 전체 목록을 볼 수 있어요.
//   관리자 = Firestore의 admins 컬렉션에 자기 UID로 된 문서가 있는 Google 계정이에요. (README 3단계)
// - 프로젝트 하나를 읽는 건 누구나 할 수 있어요. 프로젝트 ID를 알아야 하니 링크(?p=…)가 곧 열쇠예요.
// - 참여자(people)는 로그인 없이 칠할 수 있고, 문서 모양(name / joinedAt / days / pl / at)이 맞을 때만 저장돼요.
//   days = 기본 장소에 칠한 시간, pl = 다른 장소마다 같음/따로/못 감, at = 다른 장소에 따로 칠한 시간
// - 일정(meets)은 누구나 볼 수 있고, 관리자만 잡고 고치고 지울 수 있어요. who = 참가자 { 참여자ID: 이름 }
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isDay(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function isTime(v) {
      return v is string && v.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
    }
    // 없어도 되는 글자 칸: 있으면 n자 이하의 글자여야 해요
    function optStr(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'start', 'end', 'max', 'createdAt', 'owner', 'places'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && isDay(d.start) && isDay(d.end) && d.start <= d.end
        && d.max is int && d.max >= 2 && d.max <= 12
        && d.owner is string
        && (!('places' in d) || (d.places is list && d.places.size() >= 1 && d.places.size() <= 4));
    }
    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'joinedAt', 'days', 'pl', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.days is map && d.days.size() <= 400
        && (!('pl' in d) || (d.pl is map && d.pl.size() <= 12))
        && (!('at' in d) || (d.at is map && d.at.size() <= 12));
    }
    function validMeet() {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'start', 'end', 'title', 'place', 'venue', 'link', 'img', 'memo', 'who', 'createdAt'])
        && isDay(d.date) && isTime(d.start)
        && (!('end' in d) || isTime(d.end))
        && d.place is string && d.place.size() <= 20
        && optStr(d, 'title', 40) && optStr(d, 'venue', 80) && optStr(d, 'link', 500) && optStr(d, 'img', 700000) && optStr(d, 'memo', 300)
        && (!('who' in d) || (d.who is map && d.who.size() <= 24));
    }

    // 관리자 표시는 Firebase 콘솔에서만 만들어요. 페이지는 내 문서가 있는지만 확인해요.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() && validProject() && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() && validProject() && request.resource.data.owner == resource.data.owner;

      match /people/{personId} {
        allow read: if true;
        allow delete: if true;
        allow create: if exists(/databases/$(database)/documents/projects/$(projectId)) && validPerson();
        allow update: if validPerson();
      }

      match /meets/{meetId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create, update: if isAdmin() && validMeet();
      }
    }
  }
}
