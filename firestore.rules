rules_version = '2';

// 모일까용 규칙
// - 프로젝트(projects)는 관리자만 만들고, 지우고, 전체 목록을 볼 수 있어요.
//   관리자 = Firestore의 admins 컬렉션에 자기 UID로 된 문서가 있는 Google 계정이에요. (README 3단계)
// - 프로젝트 하나를 읽는 건 누구나 할 수 있어요. 프로젝트 ID를 알아야 하니 링크(?p=…)가 곧 열쇠예요.
// - 참여자(people)는 로그인 없이 칠할 수 있고, 문서 모양(name / joinedAt / days)이 맞을 때만 저장돼요.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isDay(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function validProject() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'start', 'end', 'max', 'createdAt', 'owner'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && isDay(d.start) && isDay(d.end) && d.start <= d.end
        && d.max is int && d.max >= 2 && d.max <= 12
        && d.owner == request.auth.uid;
    }
    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'joinedAt', 'days'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.days is map && d.days.size() <= 400;
    }

    // 관리자 표시는 Firebase 콘솔에서만 만들어요. 페이지는 내 문서가 있는지만 확인해요.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() && validProject();

      match /people/{personId} {
        allow read: if true;
        allow delete: if true;
        allow create: if exists(/databases/$(database)/documents/projects/$(projectId)) && validPerson();
        allow update: if validPerson();
      }
    }
  }
}
